<?xml version="1.0" encoding="utf-8"?>
<!-- Immer dunkel (die Web-App zeigt dann auch ihr dunkles Design: prefers-color-scheme folgt dem App-Thema) -->
<resources>
    <style name="Dunkel" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hintergrund</item>
        <item name="android:statusBarColor">@color/hintergrund</item>
        <item name="android:navigationBarColor">@color/hintergrund</item>
        <item name="android:colorAccent">@color/akzent</item>
    </style>
    <style name="DunkelMitTitel" parent="@android:style/Theme.Material">
        <item name="android:windowBackground">@color/hintergrund</item>
        <item name="android:statusBarColor">@color/hintergrund</item>
        <item name="android:navigationBarColor">@color/hintergrund</item>
        <item name="android:colorPrimary">@color/hintergrund</item>
        <item name="android:colorAccent">@color/akzent</item>
    </style>
    <color name="hintergrund">#161815</color>
    <color name="akzent">#4f9b74</color>
</resources>
